# Copie para `.env.e2e` (nunca commitado — .env* está no .gitignore).
# Carregado por playwright.config.ts e playwright.perf.config.ts.
#
# Use uma branch Neon SÓ de teste (ex.: `neonctl branches create --name e2e`,
# na mesma região do banco de dev), nunca o banco de dev/produção — os testes
# E2E criam e apagam usuários de verdade a cada execução.

# Neon: connection string da branch "e2e" (pooled)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.us-east-1.aws.neon.tech/amplifica?sslmode=require"
# Neon: mesma branch, conexão direta (usada só pelo `prisma migrate deploy`)
DIRECT_URL="postgresql://user:password@ep-xxxx.us-east-1.aws.neon.tech/amplifica?sslmode=require"

BETTER_AUTH_SECRET="generate-with: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"

# Ativa o transport de e-mail "arquivo" (src/lib/email.ts) — os helpers em
# e2e/helpers/mailbox.ts leem os e-mails de .e2e/mailbox/*.json em vez de uma
# caixa de e-mail real.
E2E=true

# Igual ao .env — sem RESEND_API_KEY nem R2_*, os testes de avatar upload
# ficam indisponíveis (não fazem parte do e2e/auth.spec.ts nem de perf/*).
SEED_ALLOW_WIPE=true

# --- Setup da branch (rodar uma vez, antes do primeiro pnpm test:e2e) ---
# 1. criar a branch "e2e" no console do Neon (mesma região do banco de dev)
# 2. copiar as duas connection strings acima
# 3. aplicar as migrations nela (pnpm dlx baixa o dotenv-cli na hora, sem
#    virar dependência do projeto):
#    pnpm dlx dotenv-cli -e .env.e2e -- pnpm exec prisma migrate deploy

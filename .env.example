# Copie para `.env` e preencha. A validação fica em src/lib/env.ts — o
# servidor não sobe se faltar uma variável obrigatória.

# --- Obrigatórias ---

# Neon: pooled connection (usada pelo app em runtime, via lib/prisma.ts)
DATABASE_URL="postgresql://user:password@localhost:5432/amplifica"
# Neon: conexão direta, sem pooler (usada pelo Prisma CLI — migrate/studio/db pull)
DIRECT_URL="postgresql://user:password@localhost:5432/amplifica"

# Better Auth
BETTER_AUTH_SECRET="generate-with: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"

# --- Opcionais ---

# Login social com Google — sem as duas, o botão do Google some da UI.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# E-mail transacional (verificação, redefinição de senha). O default de
# EMAIL_TRANSPORT é "console" (só loga o código no terminal) — pra enviar de
# verdade é preciso EMAIL_TRANSPORT="resend" E a RESEND_API_KEY.
# EMAIL_TRANSPORT="resend" # resend | console | file
# RESEND_API_KEY="re_..."
# EMAIL_FROM precisa ser só o endereço (sem "Nome <...>") e de um domínio
# verificado no Resend. Sem EMAIL_FROM usa onboarding@resend.dev, que só entrega
# no e-mail da própria conta do Resend (serve pra testar).
# EMAIL_FROM="no-reply@seudominio.com"

# Cloudflare R2 (upload de avatar) — sem as 5, o upload fica indisponível.
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_PUBLIC_BUCKET=""
# R2_PUBLIC_URL=""
# Bucket PRIVADO dos arquivos entregues ao comprador (presets, IRs, captures).
# Nunca deixe este bucket público. Prévia de áudio e capa continuam no
# R2_PUBLIC_BUCKET. Sem ele (e as 5 acima), o upload de arquivos de produto
# fica indisponível. Os dois buckets precisam de CORS liberando PUT (com o
# header Content-Type) a partir da origem do app (BETTER_AUTH_URL), porque o
# navegador envia o arquivo direto para a URL pré-assinada.
# R2_PRIVATE_BUCKET=""

# Protege /api/cron/* — sem isso, o endpoint sempre responde 401.
# CRON_SECRET=""

# Início do Programa Fundador (ISO 8601 em UTC). Opcional: sem ele, o painel do
# vendedor omite os dias que faltam do programa.
# FOUNDER_PROGRAM_STARTS_AT="2026-10-14T12:00:00Z"

# Usado pelo seed (prisma/seed.ts) pra permitir apagar dados locais.
SEED_ALLOW_WIPE=true

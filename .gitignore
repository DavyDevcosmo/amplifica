# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# modelos sem segredo: o README manda copiar pra .env / .env.e2e
!.env.example
!.env.e2e.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# caixa de e-mail fake lida pelo Playwright em modo E2E
/.e2e/

# navegadores do Playwright
/test-results/
/playwright-report/
/.lighthouseci/

# métricas brutas do pnpm test:perf (e2e/perf/perfReport.ts) — só a
# baseline em e2e/perf/baseline.json é versionada
/.perf-results/

# cache do hook de validação (.claude/hooks/verify.mjs) — guarda só o hash
# do último diff validado com sucesso, nada sensível
/.claude/.verify-cache
/blob-report/
/playwright/.cache/
